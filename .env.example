# Override the SQLite file location (default: ~/.taskorg/db.sqlite)
# DATABASE_URL=sqlite:///absolute/path/to/db.sqlite?mode=rwc

# Override the bind address (default: 127.0.0.1:5000)
# On the CloudDesktop set this to 0.0.0.0:5000 so Tailscale can reach it.
# BIND_ADDR=127.0.0.1:5000

# RUST_LOG=taskorg=info
